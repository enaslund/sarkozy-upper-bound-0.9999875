/-- The F1 cell counts of the pieces `0–28`. -/
def f1Cells : List ℕ :=
  [2, 2, 2, 1, 2, 4, 4, 8, 8, 8, 8, 8, 8, 8, 8,
  8, 16, 16, 16, 16, 16, 16, 16, 16, 32, 32, 128, 128, 256]

/-- The `k`-th endpoint. -/
def f1End (k : ℕ) : ℕ := (f1Ends.getD k (0, 0, 0)).1

/-- A lower bound of `log` of the `k`-th endpoint. -/
def f1Lo (k : ℕ) : ℚ := ((f1Ends.getD k (0, 0, 0)).2.1 : ℚ) / 10 ^ 16

/-- An upper bound of `log` of the `k`-th endpoint. -/
def f1Hi (k : ℕ) : ℚ := ((f1Ends.getD k (0, 0, 0)).2.2 : ℚ) / 10 ^ 16

/-- A lower bound of `log 4800162889`. -/
def lBlo : ℚ := 222919156894928035 / 10 ^ 16

/-- The error constant of piece `i`. -/
def f1Err (i : ℕ) : ℚ :=
  if i < 28 then 1174 / (1000 * (f1Sqrt.getD i 1 : ℚ)) else 2411 / (5000000 * lBlo)

/-- **The F1 data of piece `i`** (`i ≤ 28`). -/
def f1Geo (i : ℕ) : GeoQ :=
  ⟨f1Cells.getD i 1, f1Lo i, f1Hi i, f1Lo (i + 1), f1Hi (i + 1), f1Err i⟩

end Sarkozy.AnalyticCells
