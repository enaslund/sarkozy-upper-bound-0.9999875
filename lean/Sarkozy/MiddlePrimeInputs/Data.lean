namespace Sarkozy.MiddlePrimeInputs

open Sarkozy.PartV

/-- The generated list of `⌈10²²/√X_i⌉/10²²`. -/
def rUpList : List ℚ := [279847415736418043 / 1250000000000000000000, 2143862467235765541 / 10000000000000000000000, 2052969694844352347 / 10000000000000000000000, 495759502017878863 / 2500000000000000000000, 1965930510156014013 / 10000000000000000000000, 470645390032218431 / 2500000000000000000000, 863167457503109771 / 5000000000000000000000, 1583056082590454827 / 10000000000000000000000, 1451668823386549959 / 10000000000000000000000, 665593093651938387 / 5000000000000000000000, 1 / 8192, 1119389690998321847 / 10000000000000000000000, 205296975973900311 / 2000000000000000000000, 470645390032218431 / 5000000000000000000000, 863167457503109771 / 10000000000000000000000, 15830560925085647 / 200000000000000000000, 362917209670591579 / 5000000000000000000000, 332796548300305051 / 5000000000000000000000, 1 / 16384, 279847424502871149 / 5000000000000000000000, 256621219967375389 / 5000000000000000000000, 470645393159757089 / 10000000000000000000000, 215791864375777443 / 5000000000000000000000, 7915280474940461 / 200000000000000000000, 362917210148585849 / 10000000000000000000000, 332796549037472987 / 10000000000000000000000, 1 / 32768, 215791864375777443 / 10000000000000000000000, 1 / 65536, 1 / 131072, 1 / 262144, 1 / 1048576, 842936970217881 / 5000000000000000000000]

/-- `rUp i ≥ X_i^{-1/2}` (checked by `rUp_ok`). -/
def rUp (i : Fin 33) : ℚ := rUpList.getD i.val 0

/-- **The kernel check of the generated bounds**: `0 ≤ rUp i` and `1 ≤ (rUp i)² X_i`. -/
theorem rUp_ok : ∀ i : Fin 33, 0 ≤ rUp i ∧ 1 ≤ rUp i ^ 2 * (pieceStart i : ℚ) := by
  unfold rUp rUpList pieceStart pieceEnds
  decide +kernel

/-- Every piece starts at `X_i ≥ 2²⁴`. -/
theorem pieceStart_ge (i : Fin 33) : 2 ^ 24 ≤ pieceStart i := by
  revert i
  unfold pieceStart pieceEnds
  decide +kernel

end Sarkozy.MiddlePrimeInputs
