theorem diagonal_coverage00 : ∀ tc ∈ dictionary39,
    diagonalMultiplicity (dictionary39[0]!.1 ∆ tc.1) = 1 := by
  have h : ∀ tc ∈ dictionary39,
      countCode diagonalBlockCodes (Nat.xor (code dictionary39[0]!.1) (code tc.1)) = 1 := by
    decide +kernel
  intro tc htc
  change multExpr diagonalBlocks _ = 1
  rw [multExpr_eq, diagonalBlockCodes_eq, code_symmDiff, h tc htc, Nat.cast_one]

