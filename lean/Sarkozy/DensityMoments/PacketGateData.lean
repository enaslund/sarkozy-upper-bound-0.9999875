/-- The piece of index `i`. -/
def packetPiece (i : ℕ) : PieceData := packetPieces.getD i default

theorem packetPieces_length : packetPieces.length = 33 := by decide +kernel

/-- Every piece has coefficients of the right signs. -/
theorem packetPieces_valid : ∀ P ∈ packetPieces, P.Valid := by decide +kernel

/-- Every piece index below 33 has coefficients of the right signs. -/
theorem packetPiece_valid : ∀ i < 33, (packetPiece i).Valid := by decide +kernel

/-- The upper bounds of the gate table in the proof of `lem:density:packets`: the first six
pieces (by `X`), then every later piece. -/
def gateTableBound (i : ℕ) : ℚ :=
  if i = 0 then 999905396 / 10 ^ 9 else if i = 1 then 997725686 / 10 ^ 9
  else if i = 2 then 995610104 / 10 ^ 9 else if i = 3 then 993840613 / 10 ^ 9
  else if i = 4 then 993514967 / 10 ^ 9 else if i = 5 then 991403303 / 10 ^ 9
  else 830800905 / 10 ^ 9

/-- The row predicate: the certificate, the piece index, the table bound and the exact worst bound. -/
def GateRow.Full (row : GateRow) : Prop :=
  row.Check (packetPiece row.piece) ∧ row.piece < 33 ∧
    row.value (packetPiece row.piece) ≤ gateTableBound row.piece ∧
    row.value (packetPiece row.piece) ≤ 7811760900169 / 7812500000000

instance (row : GateRow) : Decidable row.Full := by unfold GateRow.Full; infer_instance

