theorem gateRows13_check : ∀ row ∈ gateRows13, row.Full := by
  decide +kernel

/-- All the joint gates. -/
def gateRows : List GateRow := gateRows0 ++ gateRows1 ++ gateRows2 ++ gateRows3 ++ gateRows4 ++ gateRows5 ++ gateRows6 ++ gateRows7 ++ gateRows8 ++ gateRows9 ++ gateRows10 ++ gateRows11 ++ gateRows12 ++ gateRows13

theorem gateRows_length : gateRows.length = 553 := by decide +kernel

/-- **The joint block-size gates** of `lem:density:packets`: every row passes. -/
theorem gateRows_full : ∀ row ∈ gateRows, row.Full := by
  intro row hrow
  simp only [gateRows, List.mem_append] at hrow
  rcases hrow with (((((((((((((h0 | h1) | h2) | h3) | h4) | h5) | h6) | h7) | h8) | h9) | h10) | h11) | h12) | h13)

  · exact gateRows0_check row h0
  · exact gateRows1_check row h1
  · exact gateRows2_check row h2
  · exact gateRows3_check row h3
  · exact gateRows4_check row h4
  · exact gateRows5_check row h5
  · exact gateRows6_check row h6
  · exact gateRows7_check row h7
  · exact gateRows8_check row h8
  · exact gateRows9_check row h9
  · exact gateRows10_check row h10
  · exact gateRows11_check row h11
  · exact gateRows12_check row h12
  · exact gateRows13_check row h13

theorem gateRows_check : ∀ row ∈ gateRows, row.Check (packetPiece row.piece) ∧ row.piece < 33 :=
  fun row hrow => ⟨(gateRows_full row hrow).1, (gateRows_full row hrow).2.1⟩

/-- The number of gates per piece: `87, 88, 70, 19, 87, 175` in the first six pieces (`526` groups
of the histogram) and one in each of the `27` later pieces. -/
theorem gateRows_per_piece : (List.range 33).map
    (fun i => (gateRows.filter (fun row => row.piece = i)).length) =
    [87, 88, 70, 19, 87, 175] ++ List.replicate 27 1 := by
  decide +kernel


