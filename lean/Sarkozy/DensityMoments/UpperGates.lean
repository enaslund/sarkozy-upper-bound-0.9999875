module

public import Sarkozy.DensityMoments.PacketGates




@[expose] public section

namespace Sarkozy.DensityMoments

open Sarkozy.Certificates

/-- One upper band: start `X`, `⌊√X⌋`, `w_CC`, `v_CC`, `S_3` and the local log budget. -/
structure UpperRow where
  X : ℕ
  sqrtX : ℕ
  w : ℚ
  v : ℚ
  s3 : ℚ
  L : ℚ
  deriving DecidableEq

namespace UpperRow

/-- The rational bad-fraction test at `r_X = 1/⌊√X⌋`. -/
def Check (row : UpperRow) : Prop :=
  1 ≤ row.sqrtX ∧ row.sqrtX ^ 2 ≤ row.X ∧ 0 ≤ row.w ∧ 0 ≤ row.v ∧ 0 < row.s3 ∧ row.L ≤ 886 ∧
    4 * (row.w + row.v * (1 / (row.sqrtX : ℚ))) * (1 / (row.sqrtX : ℚ)) ^ 3 / row.s3 <
      1 / 10 ^ 16

instance (row : UpperRow) : Decidable row.Check := by unfold Check; infer_instance

/-- **Soundness**: at every prime `b ≥ X`, with `r = b^{-1/2}`, the bad fraction
`4 (w_CC + v_CC r) r^3 / S_3` is below `10^{-16}`. -/
theorem sound {row : UpperRow} (h : row.Check) {b : ℝ} (hb : (row.X : ℝ) ≤ b) :
    4 * ((row.w : ℝ) + row.v * (1 / Real.sqrt b)) * (1 / Real.sqrt b) ^ 3 / row.s3 <
      1 / 10 ^ 16 := by
  obtain ⟨h1, h2, hw, hv, hs, _, hlt⟩ := h
  have hs1 : (1 : ℝ) ≤ row.sqrtX := by exact_mod_cast h1
  have hs2 : ((row.sqrtX : ℝ)) ^ 2 ≤ row.X := by exact_mod_cast h2
  have hw' : (0 : ℝ) ≤ row.w := by exact_mod_cast hw
  have hv' : (0 : ℝ) ≤ row.v := by exact_mod_cast hv
  have hs' : (0 : ℝ) < row.s3 := by exact_mod_cast hs
  have hb0 : (0 : ℝ) < b := by nlinarith
  have hsqrt : (row.sqrtX : ℝ) ≤ Real.sqrt b := by
    rw [show (row.sqrtX : ℝ) = Real.sqrt ((row.sqrtX : ℝ) ^ 2) by
      rw [Real.sqrt_sq (by linarith)]]
    exact Real.sqrt_le_sqrt (hs2.trans hb)
  have hr : 1 / Real.sqrt b ≤ 1 / (row.sqrtX : ℝ) :=
    one_div_le_one_div_of_le (by linarith) hsqrt
  have hr0 : 0 ≤ 1 / Real.sqrt b := by positivity
  have hlt' : ((4 * (row.w + row.v * (1 / (row.sqrtX : ℚ))) * (1 / (row.sqrtX : ℚ)) ^ 3 /
      row.s3 : ℚ) : ℝ) < ((1 / 10 ^ 16 : ℚ) : ℝ) := by exact_mod_cast hlt
  push_cast at hlt'
  refine lt_of_le_of_lt ?_ hlt'
  apply div_le_div_of_nonneg_right _ hs'.le
  apply mul_le_mul _ (pow_le_pow_left₀ hr0 hr 3) (by positivity) (by positivity)
  apply mul_le_mul_of_nonneg_left _ (by norm_num)
  have := mul_le_mul_of_nonneg_left hr hv'
  linarith

end UpperRow

