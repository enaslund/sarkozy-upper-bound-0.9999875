/-- Every weight of F3E3 is positive and every word pair used by its mask sums is present. -/
theorem F3E3_tablePos : tablePos tableF3E3 3 3 = true := by
  decide +kernel

/-- The kernel check of the mask conditions of F3E3. -/
theorem F3E3_maskCheck : maskCheck tableF3E3 3 3 = true := by
  decide +kernel

/-- **`cert:envelopes`(b), F3E3: the mask conditions `eq:oct24:mask-schur`.** For every mask with
`k` fold arms and `a` matching arms, `maskSum k a · maskSum (3 - k) (3 - a) ≤ 1`. -/
theorem F3E3_mask {k a : ℕ} (hk : k ≤ 3) (ha : a ≤ 3) :
    maskSum tableF3E3 3 3 k a * maskSum tableF3E3 3 3 (3 - k) (3 - a) ≤ 1 :=
  mask_sound F3E3_tablePos F3E3_maskCheck hk ha

end Sarkozy.Envelopes
