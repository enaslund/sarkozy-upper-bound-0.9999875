    200000000000000000000000000000),
  (([4, 4], [1, 2, 2, 2]),
    49100000000000000000491,
    250000000000000000000000000000),
  (([4, 4], [2, 2, 2, 2]),
    59100000000000000000591,
    100000000000000000000000000000)
]

/-- Every weight of F2E4 is positive and every word pair used by its mask sums is present. -/
theorem F2E4_tablePos : tablePos tableF2E4 2 4 = true := by
  decide +kernel

/-- The kernel check of the mask conditions of F2E4. -/
theorem F2E4_maskCheck : maskCheck tableF2E4 2 4 = true := by
  decide +kernel

/-- **`cert:envelopes`(b), F2E4: the mask conditions `eq:oct24:mask-schur`.** For every mask with
`k` fold arms and `a` matching arms, `maskSum k a · maskSum (2 - k) (4 - a) ≤ 1`. -/
theorem F2E4_mask {k a : ℕ} (hk : k ≤ 2) (ha : a ≤ 4) :
    maskSum tableF2E4 2 4 k a * maskSum tableF2E4 2 4 (2 - k) (4 - a) ≤ 1 :=
  mask_sound F2E4_tablePos F2E4_maskCheck hk ha

end Sarkozy.Envelopes
