/-- Every weight of F4E2 is positive and every word pair used by its mask sums is present. -/
theorem F4E2_tablePos : tablePos tableF4E2 4 2 = true := by
  decide +kernel

/-- The kernel check of the mask conditions of F4E2. -/
theorem F4E2_maskCheck : maskCheck tableF4E2 4 2 = true := by
  decide +kernel

/-- **`cert:envelopes`(b), F4E2: the mask conditions `eq:oct24:mask-schur`.** For every mask with
`k` fold arms and `a` matching arms, `maskSum k a · maskSum (4 - k) (2 - a) ≤ 1`. -/
theorem F4E2_mask {k a : ℕ} (hk : k ≤ 4) (ha : a ≤ 2) :
    maskSum tableF4E2 4 2 k a * maskSum tableF4E2 4 2 (4 - k) (2 - a) ≤ 1 :=
  mask_sound F4E2_tablePos F4E2_maskCheck hk ha

end Sarkozy.Envelopes
