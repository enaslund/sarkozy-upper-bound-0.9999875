/-- Every weight of F6E0 is positive and every word pair used by its mask sums is present. -/
theorem F6E0_tablePos : tablePos tableF6E0 6 0 = true := by
  decide +kernel

/-- The kernel check of the mask conditions of F6E0. -/
theorem F6E0_maskCheck : maskCheck tableF6E0 6 0 = true := by
  decide +kernel

/-- **`cert:envelopes`(b), F6E0: the mask conditions `eq:oct24:mask-schur`.** For every mask with
`k` fold arms and `a` matching arms, `maskSum k a · maskSum (6 - k) (0 - a) ≤ 1`. -/
theorem F6E0_mask {k a : ℕ} (hk : k ≤ 6) (ha : a ≤ 0) :
    maskSum tableF6E0 6 0 k a * maskSum tableF6E0 6 0 (6 - k) (0 - a) ≤ 1 :=
  mask_sound F6E0_tablePos F6E0_maskCheck hk ha

end Sarkozy.Envelopes
