/-- Every weight of F5E1 is positive and every word pair used by its mask sums is present. -/
theorem F5E1_tablePos : tablePos tableF5E1 5 1 = true := by
  decide +kernel

/-- The kernel check of the mask conditions of F5E1. -/
theorem F5E1_maskCheck : maskCheck tableF5E1 5 1 = true := by
  decide +kernel

/-- **`cert:envelopes`(b), F5E1: the mask conditions `eq:oct24:mask-schur`.** For every mask with
`k` fold arms and `a` matching arms, `maskSum k a · maskSum (5 - k) (1 - a) ≤ 1`. -/
theorem F5E1_mask {k a : ℕ} (hk : k ≤ 5) (ha : a ≤ 1) :
    maskSum tableF5E1 5 1 k a * maskSum tableF5E1 5 1 (5 - k) (1 - a) ≤ 1 :=
  mask_sound F5E1_tablePos F5E1_maskCheck hk ha

end Sarkozy.Envelopes
